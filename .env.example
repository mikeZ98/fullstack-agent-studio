# Copy to .env.local and fill in. Never commit real values: .env* files are git-ignored
# (except this template). Validated at boot by src/lib/env.ts.

# --- Server-only -------------------------------------------------------------
# Upstream agent backend endpoint that streams Server-Sent Events (http/https).
BACKEND_SSE_URL=http://localhost:8000/v1/stream

# --- Client (inlined into the browser bundle; never put secrets here) --------
# Public base URL of the studio API used by browser-side requests (http/https).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Tooling -----------------------------------------------------------------
# Any non-empty value skips env validation. Only for CI lint/typegen; never at runtime.
SKIP_ENV_VALIDATION=
