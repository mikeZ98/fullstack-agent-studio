{
  "name": "fullstack-agent-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Split-pane agent studio: streaming chat on the left, interactive artifact canvas on the right.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "SKIP_ENV_VALIDATION=1 next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && scripts/audit-attribution.sh",
    "audit:attribution": "scripts/audit-attribution.sh"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.159",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "7.0.155",
    "clsx": "^2.1.1",
    "geist": "^1.8.2",
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
