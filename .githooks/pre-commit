#!/usr/bin/env bash
# pre-commit: enforce contributor identity, block build/cache/secret files, run Biome
# on staged sources.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=_policy.sh
source "$ROOT/.githooks/_policy.sh"

fail=0

studio_check_pending_identities || fail=1

# Staged paths that must never be committed.
forbidden_paths="$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '(^|/)(\.cache|node_modules|\.next|out|build|coverage|\.vercel|\.turbo)/|(^|/)\.env(\..+)?$|(^|/)\.envrc\.local$|\.tsbuildinfo$|\.(pem|key|p12|pfx|sqlite|sqlite3|db)$' |
  grep -vE '(^|/)\.env\.example$' || true)"
if [[ -n "$forbidden_paths" ]]; then
  studio_err "Refusing to commit build output, cache, dependency, database or secret files:"
  sed 's/^/    /' <<<"$forbidden_paths" >&2
  fail=1
fi

# Biome (lint + format + import sorting) on staged files; warnings are errors.
if [[ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]]; then
  biome_bin="$ROOT/node_modules/.bin/biome"
  if [[ -x "$biome_bin" ]]; then
    "$biome_bin" check --staged --error-on-warnings --no-errors-on-unmatched --colors=off || fail=1
  else
    studio_err "biome not found at $biome_bin — run 'pnpm install' (with direnv loaded)."
    fail=1
  fi
fi

exit "$fail"
