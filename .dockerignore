# Build context: only what the image build needs. Secrets, VCS metadata, local caches and
# builds, tests and tooling never reach the Docker daemon.

# VCS and git hooks
.git
.gitignore
.githooks

# Dependencies and build output (rebuilt inside the image)
node_modules
**/node_modules
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Project-local caches and stores (see .envrc)
.cache

# Secrets and local environment (.env, .env.local, .envrc, ...)
.env*
**/.env*

# Tests, test config and coverage
tests
**/*.test.ts
**/*.test.tsx
vitest.config.mts
coverage
.vitest
junit.xml

# Tooling that is not part of the build
biome.json
scripts
!scripts/healthcheck.mjs

# Container and editor files
Dockerfile
.dockerignore
docker-compose.yml
.vscode
.idea
.DS_Store
*.log
*.pem
