# shellcheck shell=bash
# fullstack-agent-studio — direnv environment.
#
# Pins every cache, package store, temp dir and build artifact under ./.cache/ so
# nothing spills onto the internal macOS disk. Run `direnv allow` once.

# ---------------------------------------------------------------------------
# Project root & SSD pinning guard (fails closed: nothing is exported on error)
# ---------------------------------------------------------------------------
PROJECT_ROOT="$(cd "$(expand_path .)" && pwd -P)"
SSD_VOLUME="/Volumes/KINGSTONE_SSD"

if [[ "$(uname -s)" == "Darwin" ]]; then
  if ! mount | grep -qF " on $SSD_VOLUME ("; then
    log_error "$SSD_VOLUME is not mounted — refusing to load (caches would land on the internal disk)."
    exit 1
  fi
  if [[ "$PROJECT_ROOT" != "$SSD_VOLUME"/* ]]; then
    log_error "PROJECT_ROOT ($PROJECT_ROOT) resolves outside $SSD_VOLUME — refusing to load."
    exit 1
  fi
  if [[ ! -w "$PROJECT_ROOT" ]]; then
    log_error "$PROJECT_ROOT is not writable (read-only mount?) — refusing to load."
    exit 1
  fi
fi

export PROJECT_ROOT SSD_VOLUME
export CACHE_ROOT="$PROJECT_ROOT/.cache"

# ---------------------------------------------------------------------------
# XDG + temp
# ---------------------------------------------------------------------------
export XDG_CACHE_HOME="$CACHE_ROOT/xdg"
export XDG_DATA_HOME="$CACHE_ROOT/xdg-data"
export XDG_STATE_HOME="$CACHE_ROOT/xdg-state"
export TMPDIR="$CACHE_ROOT/tmp"
export TMP="$TMPDIR" TEMP="$TMPDIR"

# ---------------------------------------------------------------------------
# Node toolchain (pnpm CLI + content-addressable store live under .cache/)
# ---------------------------------------------------------------------------
export PNPM_HOME="$CACHE_ROOT/pnpm"
export npm_config_store_dir="$CACHE_ROOT/pnpm-store"
export npm_config_cache="$CACHE_ROOT/npm"
export COREPACK_HOME="$CACHE_ROOT/corepack"
PATH_add "$PNPM_HOME"
PATH_add "$CACHE_ROOT/pnpm-cli/bin"
PATH_add "$PROJECT_ROOT/node_modules/.bin"

if ! has pnpm; then
  log_status "pnpm not found — bootstrap it with: npm i -g --prefix \"$CACHE_ROOT/pnpm-cli\" pnpm@10"
fi

# No usage telemetry leaves the machine.
export NEXT_TELEMETRY_DISABLED="1"
export DO_NOT_TRACK="1"

mkdir -p \
  "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$TMPDIR" \
  "$PNPM_HOME" "$npm_config_store_dir" "$npm_config_cache" "$COREPACK_HOME"

# ---------------------------------------------------------------------------
# Git: hooks + sole-contributor identity
# ---------------------------------------------------------------------------
# Identity values mirror .githooks/_policy.sh (the enforcement source of truth).
if git -C "$PROJECT_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$PROJECT_ROOT" config core.hooksPath .githooks
  git -C "$PROJECT_ROOT" config user.name "mikeZ98"
  git -C "$PROJECT_ROOT" config user.email "145975972+mikeZ98@users.noreply.github.com"
  git -C "$PROJECT_ROOT" config user.useConfigOnly true
fi

source_env_if_exists .envrc.local
